let practiceSession = null;

function startPractice() {
  const subj = document.getElementById('pSubject').value;
  const year = document.getElementById('pYear').value;
  const topic = document.getElementById('pTopic').value;
  const count = parseInt(document.getElementById('pCount').value) || 10;
  const diff = document.getElementById('pDiff').value;
  const timed = document.getElementById('pTimed').value === 'timed';

  let pool = state.questions.filter(q => {
    if (subj && q.subject !== subj) return false;
    if (year && String(q.year) !== String(year)) return false;
    if (topic && q.topic !== topic) return false;
    if (diff && q.difficulty !== diff) return false;
    return q.question && q.correct_answer;
  });

  if (pool.length === 0) {
    document.getElementById('practiceArea').innerHTML = `<div class="card"><div class="notice notice-danger">No matching verified questions in your local database. Import verified EUEE questions first via <strong>Data Import</strong>.</div></div>`;
    return;
  }

  pool = pool.sort(() => Math.random() - 0.5).slice(0, count);
  practiceSession = {
    questions: pool,
    answers: {},
    startTime: Date.now(),
    timeLimit: timed ? 30*60*1000 : null,
    subject: subj || "Mixed"
  };

  renderPracticeQuestions();
  if (timed) startTimer();
}

let practiceTimer = null;
function startTimer() {
  clearInterval(practiceTimer);
  practiceTimer = setInterval(() => {
    if (!practiceSession) { clearInterval(practiceTimer); return; }
    const el = document.getElementById('practiceTimer');
    if (!el) { clearInterval(practiceTimer); return; }
    const elapsed = Date.now() - practiceSession.startTime;
    const remaining = practiceSession.timeLimit - elapsed;
    if (remaining <= 0) {
      el.textContent = "00:00";
      clearInterval(practiceTimer);
      finishPractice();
    } else {
      const m = Math.floor(remaining/60000);
      const s = Math.floor((remaining%60000)/1000);
      el.textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
    }
  }, 500);
}

