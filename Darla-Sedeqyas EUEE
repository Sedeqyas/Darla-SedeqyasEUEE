   SETTINGS
   ========================================================= */
function renderSettings() {
  const s = state.settings;
  return `
    <div class="card">
      <h3>Student preferences</h3>
      <div class="grid grid-2">
        <div class="field">
          <label>Student name (optional)</label>
          <input value="${esc(s.studentName)}" onchange="state.settings.studentName=this.value;save('settings')" />
        </div>
        <div class="field">
          <label>Study start date</label>
          <input type="date" value="${esc(s.startDate)}" onchange="state.settings.startDate=this.value;save('settings');render()" />
          <div class="help">Week 1 begins on this date. The planner computes the current week automatically.</div>
        </div>
      </div>
    </div>

    <div class="card">
      <h3>About the study-priority label</h3>
      <div class="notice">
        "High priority", "Medium priority" and "Foundation" are <strong>study-priority estimates based on historical patterns, curriculum importance, or available data</strong>.
        They are <strong>not</strong> guarantees that a topic will appear on the future EUEE exam.
      </div>
    </div>

    <div class="card">
      <h3>Offline capability</h3>
      <p class="muted">This app runs fully offline. All state is stored in <code>localStorage</code>. External chart library is cached on first load by your browser; if you lose internet the planner continues to work.</p>
    </div>

    <div class="card">
      <h3>Storage usage</h3>
      <div id="storageInfo" class="muted">Calculating…</div>
      <button class="btn btn-outline mt-2" onclick="calcStorage()">Refresh</button>
    </div>
  `;
  setTimeout(calcStorage, 50);
}
function calcStorage() {
  let total = 0;
  Object.values(STORAGE_KEYS).forEach(k => {
    const v = localStorage.getItem(k);
    if (v) total += v.length;
  });
  const el = document.getElementById('storageInfo');
  if (el) el.textContent = `~${(total/1024).toFixed(1)} KB used across ${Object.keys(STORAGE_KEYS).length} keys.`;
}

/* =========================================================
   SEARCH (global)
   ========================================================= */
document.getElementById('globalSearch').addEventListener('input', e => {
  const v = e.target.value.trim();
  state.filters.search = v;
  if (v && state.page !== 'curriculum' && state.page !== 'euee') navigate('euee');
  else render();
});

/* =========================================================
   ATTACH HANDLERS
   ========================================================= */
function attachHandlers() {
  // Populate high priority list on dashboard from analysis if available
  const hp = document.getElementById('highPriorityList');
  if (hp) {
    const a = computeAnalysis();
    if (!a) {
      hp.innerHTML = `<span class="muted">Insufficient verified data. Import EUEE questions to compute historical study priorities.</span>`;
    } else {
      const top = a.rows.filter(r => r.priority === 'High').slice(0, 6);
      hp.innerHTML = top.length ? top.map(r => `
        <div class="flex-between" style="padding:6px 0;border-bottom:1px solid var(--border);">
          <div><strong>${esc(r.topic)}</strong> <span class="badge badge-blue">${esc(r.subject)}</span></div>
          <div class="muted">${r.count} questions • ${r.pctExams}% of exams</div>
        </div>
      `).join("") + `<div class="hint mt-2">Historical study-priority estimate — not a prediction of the actual exam.</div>` :
        `<span class="muted">No topics met the high-priority threshold in your verified dataset.</span>`;
    }
  }
}

/* =========================================================
   INIT
   ========================================================= */
updateStreak();
navigate('dashboard');

/* Close modal on Escape */
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
