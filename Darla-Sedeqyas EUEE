/* =========================================================
   RENDER — router
   ========================================================= */
function render() {
  const c = document.getElementById('pageContent');
  switch(state.page) {
    case 'dashboard': c.innerHTML = renderDashboard(); break;
    case 'plan': c.innerHTML = renderPlan(); break;
    case 'curriculum': c.innerHTML = renderCurriculum(); break;
    case 'euee': c.innerHTML = renderEuee(); break;
    case 'practice': c.innerHTML = renderPractice(); break;
    case 'analysis': c.innerHTML = renderAnalysis(); break;
    case 'errors': c.innerHTML = renderErrors(); break;
    case 'english': c.innerHTML = renderEnglish(); break;
    case 'aptitude': c.innerHTML = renderAptitude(); break;
    case 'progress': c.innerHTML = renderProgress(); break;
    case 'import': c.innerHTML = renderImport(); break;
    case 'settings': c.innerHTML = renderSettings(); break;
  }
  attachHandlers();
  if (state.page === 'analysis') drawAnalysisCharts();
}

/* =========================================================
   DASHBOARD
   ========================================================= */
function renderDashboard() {
  const completed = getCompletedTasks();
  const total = getTotalTasks();
  const pct = Math.round(completed/total*100);
  const wk = getCurrentWeek();
  const phase = getCurrentPhase();
  const planWeek = PLAN.find(p => p.wk === wk) || PLAN[0];
  const focusTopics = planWeek.topic;

  const questionsSolved = state.practice.reduce((a,p) => a + (p.total||0), 0);
  const correct = state.practice.reduce((a,p) => a + (p.correct||0), 0);
  const avg = questionsSolved ? Math.round(correct/questionsSolved*100) : 0;

  // weakest subject by practice scores
  const subjScores = {};
  state.practice.forEach(p => {
    SUBJECTS.forEach(s => {
      if (p.subject === s) {
        subjScores[s] = subjScores[s] || { correct:0, total:0 };
        subjScores[s].correct += p.correct||0;
        subjScores[s].total += p.total||0;
      }
    });
  });
  let weakest = "—";
  let weakScore = 101;
  Object.entries(subjScores).forEach(([s,v]) => {
    const sc = v.total ? v.correct/v.total*100 : 100;
    if (sc < weakScore) { weakScore = sc; weakest = s; }
  });

  // today's study
  const todayIdx = (new Date().getDay() + 6) % 7; // Mon=0
  const todayRoutine = WEEKLY_ROUTINE[todayIdx];

  return `
    <div class="card" style="background:linear-gradient(135deg,#0b2545,#13315c);color:#fff;">
      <div class="flex-between" style="flex-wrap:wrap;gap:14px;">
        <div>
          <div style="font-size:13px;color:#e6c34a;font-weight:600;letter-spacing:.05em;">WEEK ${wk} OF 24</div>
          <div style="font-size:20px;font-weight:700;margin-top:4px;">Current focus: ${esc(planWeek.grade)}</div>
          <div style="font-size:13px;opacity:.85;margin-top:4px;">${Object.values(focusTopics).join(" • ")}</div>
        </div>
        <div style="text-align:right;">
          <div style="font-size:12px;opacity:.75;">Current phase</div>
          <div style="font-size:15px;font-weight:600;color:#e6c34a;">${esc(phase)}</div>
        </div>
      </div>
      <div style="margin-top:14px;">
        <div style="display:flex;justify-content:space-between;font-size:12px;opacity:.85;">
          <span>Overall completion</span><span>${pct}%</span>
        </div>
        <div class="progress-bar" style="background:rgba(255,255,255,.15);"><div style="width:${pct}%;background:linear-gradient(90deg,#16a34a,#e6c34a);"></div></div>
      </div>
    </div>

    <div class="grid grid-4">
      <div class="card stat">
        <div class="label">Tasks completed</div>
        <div class="value">${completed}<span style="font-size:15px;color:var(--muted);">/${total}</span></div>
      </div>
      <div class="card stat">
        <div class="label">EUEE questions solved</div>
        <div class="value gold">${questionsSolved}</div>
      </div>
      <div class="card stat">
        <div class="label">Average score</div>
        <div class="value ${avg>=70?'green':avg>=50?'gold':'red'}">${avg}%</div>
      </div>
      <div class="card stat">
        <div class="label">Weakest subject</div>
        <div class="value red" style="font-size:18px;">${esc(weakest)}</div>
      </div>
    </div>

    <div class="grid grid-2">
      <div class="card">
        <h3>📚 Today's study — ${todayRoutine.day}</h3>
        <table>
          <tr><th>Subject</th><th>Hours</th></tr>
          ${todayRoutine.items.map(i => `<tr><td>${esc(i.subject)}</td><td>${i.hours}h</td></tr>`).join("")}
        </table>
        <div class="hint mt-2">Based on the fixed weekly routine. Sunday = timed EUEE paper + marking + review.</div>
      </div>

      <div class="card">
        <h3>🔥 Study streak</h3>
        <div class="grid grid-2">
          <div class="stat"><div class="label">Daily streak</div><div class="value">${state.streak.days || 0} <span style="font-size:14px;color:var(--muted);">days</span></div></div>
          <div class="stat"><div class="label">Weekly active</div><div class="value">${state.streak.weekly || 0}</div></div>
        </div>
        <div class="hint mt-2">Streak increases on the first completed task each day.</div>
      </div>
    </div>

    <div class="card">
      <h3>⚠️ Important note</h3>
      <div class="notice">
        This planner organises your preparation. It does <strong>not</strong> predict the actual EUEE exam.
        Any "high priority" label reflects historical frequency or curriculum importance — not a guarantee of appearance.
      </div>
