function templateDownload(type) {
  let csv, name;
  if (type === 'euee') {
    csv = 'year,ec_year,stream,subject,grade,unit,topic,question_number,question,choice_a,choice_b,choice_c,choice_d,correct_answer,explanation,difficulty,source\n';
    name = 'euee_template.csv';
  } else {
    csv = 'grade,stream,subject,unit,chapter,topic,subtopic,learning_objective,key_concepts,page,source\n';
    name = 'curriculum_template.csv';
  }
  downloadFile(name, csv);
}

/* =========================================================
   EXPORT
   ========================================================= */
function downloadFile(name, content, type='text/plain') {
  const blob = new Blob([content], { type });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = name; a.click();
  setTimeout(()=>URL.revokeObjectURL(url), 1000);
}
function exportJSON(which) {
  const data = state[which];
  downloadFile(`euee_${which}_${Date.now()}.json`, JSON.stringify(data, null, 2), 'application/json');
}
function exportCSV(which) {
  const rows = state[which];
  if (!Array.isArray(rows) || !rows.length) { alert('Nothing to export.'); return; }
  const keys = [...new Set(rows.flatMap(r => Object.keys(r)))];
  const escape = v => `"${String(v ?? '').replace(/"/g,'""')}"`;
  const csv = keys.join(',') + '\n' + rows.map(r => keys.map(k => escape(r[k])).join(',')).join('\n');
  downloadFile(`euee_${which}_${Date.now()}.csv`, csv, 'text/csv');
}

