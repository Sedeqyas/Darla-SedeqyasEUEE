function finishPractice() {
  clearInterval(practiceTimer);
  const s = practiceSession;
  if (!s) return;
  const timeUsed = Date.now() - s.startTime;
  let correct = 0, incorrect = 0;
  const details = [];
  const wrongTopics = new Set();

  s.questions.forEach((q,i) => {
    const user = s.answers[i];
    const right = (q.correct_answer||'').toUpperCase();
    const ok = user === right;
    if (ok) correct++; else incorrect++;
    if (!ok) {
      if (q.topic) wrongTopics.add(q.topic);
      // add to error log
      state.errors.push({
        id: Date.now() + Math.random(),
        date: new Date().toISOString(),
        subject: q.subject || s.subject,
        topic: q.topic || '—',
        question: q.question || '',
        mistakeType: 'Concept misunderstanding',
        correctConcept: q.explanation || '',
        note: '',
        retested: false,
        mastered: false
      });
    }
    details.push({ q, user, right, ok });
  });
  save('errors');

  const pct = Math.round(correct / s.questions.length * 100);
  state.practice.push({
    ts: Date.now(),
    subject: s.subject,
    total: s.questions.length,
    correct,
    pct,
    timeUsed
  });
  save('practice');
  updateStreak();

  const html = `
    <div class="card">
      <h3>Session results</h3>
      <div class="grid grid-3">
        <div class="stat"><div class="label">Score</div><div class="value green">${correct}/${s.questions.length}</div></div>
        <div class="stat"><div class="label">Percentage</div><div class="value ${pct>=70?'green':pct>=50?'gold':'red'}">${pct}%</div></div>
        <div class="stat"><div class="label">Time used</div><div class="value">${Math.round(timeUsed/60000)} min</div></div>
      </div>
      ${wrongTopics.size ? `<div class="notice mt-2"><strong>Weak topics:</strong> ${[...wrongTopics].map(esc).join(", ")} — added to your Error Log.</div>` : `<div class="notice notice-info mt-2">All answers correct. Excellent.</div>`}
      <h3 class="mt-3">Detailed review</h3>
      ${details.map((d,i) => `
        <div class="card" style="border-left:4px solid ${d.ok?'var(--green)':'var(--red)'};">
          <div class="flex-between">
            <div><strong>Q${i+1}.</strong> ${esc(d.q.question)}</div>
            <span class="badge ${d.ok?'badge-green':'badge-high'}">${d.ok?'Correct':'Incorrect'}</span>
          </div>
          <div class="muted mt-2">Your answer: <strong>${esc(d.user||'—')}</strong> • Correct: <strong>${esc(d.right||'—')}</strong></div>
          ${d.q.explanation ? `<div class="mt-2" style="font-size:13px;">${esc(d.q.explanation)}</div>` : ''}
        </div>
      `).join("")}
      <button class="btn btn-outline mt-2" onclick="practiceSession=null;render()">New practice session</button>
    </div>
  `;
  document.getElementById('practiceArea').innerHTML = html;
  practiceSession = null;
}

/* =========================================================
   TOPIC ANALYSIS
   ========================================================= */
function computeAnalysis() {
  const qs = state.questions.filter(q => q.topic && q.subject);
  if (qs.length === 0) return null;

  const byTopic = {};
  qs.forEach(q => {
    const k = `${q.subject}||${q.topic}`;
    byTopic[k] = byTopic[k] || { subject:q.subject, topic:q.topic, count:0, years:new Set(), difficulties:{}, lastYear:0 };
    byTopic[k].count++;
    if (q.year) { byTopic[k].years.add(q.year); byTopic[k].lastYear = Math.max(byTopic[k].lastYear, +q.year); }
    if (q.difficulty) byTopic[k].difficulties[q.difficulty] = (byTopic[k].difficulties[q.difficulty]||0)+1;
  });

  const allYears = [...new Set(qs.map(q => +q.year).filter(Boolean))];
  const totalExams = allYears.length;

  const rows = Object.values(byTopic).map(t => {
    const examCoverage = t.years.size;
    const pctExams = totalExams ? Math.round(examCoverage/totalExams*100) : 0;
    // study priority (documented factors only)
    let priority = "Foundation";
    if (t.count >= 5 && pctExams >= 50) priority = "High";
    else if (t.count >= 3 || pctExams >= 30) priority = "Medium";
    return { ...t, examCoverage, totalExams, pctExams, priority };
  }).sort((a,b) => b.count - a.count);

  return { rows, allYears, totalExams };
}

