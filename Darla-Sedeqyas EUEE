/* =========================================================
   24-WEEK PLAN
   ========================================================= */
function renderPlan() {
  const curWk = getCurrentWeek();
  return PLAN.map(w => {
    const doneCount = ["Biology","Chemistry","Physics","Mathematics"].filter(s => isTaskDone(w.wk, s)).length;
    const allDone = doneCount === 4;
    const isCurrent = w.wk === curWk;
    const gradeClass = w.grade.includes("Grade 9") ? "badge-blue" :
                       w.grade.includes("Grade 10") ? "badge-green" :
                       w.grade.includes("Grade 11") ? "badge-medium" :
                       w.grade.includes("Grade 12") ? "badge-high" :
                       w.grade.includes("Mixed") ? "badge-gold" : "badge-gray";
    return `
    <div class="week-section" style="${isCurrent?'border:2px solid var(--gold);':''}">
      <div class="week-header">
        <div>Week ${w.wk} — <span class="grade-tag">${esc(w.grade)}</span>${isCurrent?' <span style="font-size:11px;background:#e6c34a;color:#3a2f00;padding:2px 8px;border-radius:4px;font-weight:700;">CURRENT</span>':''}</div>
        <div class="badge ${allDone?'badge-green':'badge-gray'}">${doneCount}/4 completed</div>
      </div>
      <div class="week-body">
        <table>
          <tr><th style="width:40px;"></th><th style="width:130px;">Subject</th><th>Topic</th><th style="width:60px;text-align:center;">Done</th></tr>
          ${["Biology","Chemistry","Physics","Mathematics"].map(s => {
            const topic = w.topic[s];
            const isHigh = /HIGH PRIORITY/i.test(topic);
            const cleanTopic = topic.replace(/— HIGH PRIORITY/i, '').trim();
            return `<tr>
              <td><input type="checkbox" class="chk" ${isTaskDone(w.wk,s)?'checked':''} onchange="toggleTask(${w.wk},'${s}');this.closest('tr').querySelectorAll('.chk')[0].checked=this.checked;render()"></td>
              <td>${s}</td>
              <td class="topic-cell" onclick="openTopicPanel(${w.wk},'${s}','${esc(cleanTopic).replace(/'/g,"\\'")}','${esc(w.grade)}')">
                ${esc(cleanTopic)} ${isHigh?'<span class="badge badge-high">HIGH PRIORITY*</span>':''}
              </td>
              <td style="text-align:center;"><input type="checkbox" class="chk" ${isTaskDone(w.wk,s)?'checked':''} onchange="toggleTask(${w.wk},'${s}');render()"></td>
            </tr>`;
          }).join("")}
        </table>
      </div>
    </div>`;
  }).join("") + `
  <div class="notice">
    * <strong>HIGH PRIORITY</strong> is a study-priority label based on curriculum importance and historical frequency patterns — it does not guarantee that the topic will appear on the future EUEE exam.
  </div>`;
}

/* =========================================================
   TOPIC PANEL (modal)
   ========================================================= */
function openTopicPanel(wk, subject, topic, grade) {
  const key = `${wk}_${subject}`;
  const note = state.notes[key] || "";
  const done = isTaskDone(wk, subject);
  const high = /HIGH PRIORITY/i.test(topic) || /Genetics/i.test(topic);
  const med = /Human body|Cell division|Electricity|Integration|Organic|Limits/i.test(topic);
  const priority = high ? "High" : med ? "Medium" : "Foundation";
  const badgeClass = high ? "badge-high" : med ? "badge-medium" : "badge-foundation";

  // Related EUEE questions from DB
  const related = state.questions.filter(q => {
    const s1 = (q.subject||"").toLowerCase() === subject.toLowerCase();
    const t1 = (q.topic||"").toLowerCase();
    const t2 = topic.toLowerCase().split("—")[0].trim();
    return s1 && (t1.includes(t2) || t2.includes(t1) || (t1 && t2.includes(t1.split(" ")[0])));
  });

  const html = `
    <button class="modal-close" onclick="closeModal()">✕</button>
    <h3>${esc(topic)}</h3>
    <div class="modal-meta">Week ${wk} • ${esc(grade)} • <strong>${esc(subject)}</strong></div>

    <div class="flex" style="gap:8px;flex-wrap:wrap;margin-bottom:14px;">
      <span class="badge ${badgeClass}">Priority: ${priority}</span>
      <span class="badge badge-gray">Difficulty: Not graded</span>
      <span class="badge badge-blue">Source: Curriculum plan</span>
    </div>

    <div class="field">
      <label>Key concepts</label>
      <div class="help">No verified curriculum entry linked yet. Add entries via <strong>Data Import</strong> with textbook references to populate this.</div>
    </div>

    <div class="field">
      <label>What to learn / Recommended study order</label>
      <div class="help">Connect a verified curriculum record to display learning objectives and page references. Until then, treat as a study anchor for this week.</div>
    </div>

    <div class="field">
      <label>Past EUEE questions connected to this topic</label>
      ${related.length ? `<div class="help">${related.length} question(s) in your local database.</div>` :
        `<div class="help">No verified questions stored locally for this topic yet. Import a verified dataset to enable linkage.</div>`}
    </div>

    <div class="field">
      <label>Completion</label>
      <label class="flex" style="font-weight:400;font-size:13px;cursor:pointer;">
        <input type="checkbox" class="chk" ${done?'checked':''} onchange="toggleTask(${wk},'${subject}');closeModal();" />
        Mark this topic as completed
      </label>
    </div>

    <div class="field">
      <label>Notes</label>
      <textarea rows="3" id="topicNote" placeholder="Your personal notes, questions to ask your teacher, etc.">${esc(note)}</textarea>
    </div>

    <div class="flex" style="justify-content:flex-end;gap:8px;">
      <button class="btn btn-outline" onclick="closeModal()">Close</button>
      <button class="btn btn-green" onclick="saveTopicNote('${key}')">Save notes</button>
    </div>
  `;
  document.getElementById('modalContent').innerHTML = html;
  document.getElementById('modal').classList.add('open');
}

function saveTopicNote(key) {
  const v = document.getElementById('topicNote').value;
  state.notes[key] = v;
  save('notes');
  closeModal();
}

function closeModal() { document.getElementById('modal').classList.remove('open'); }
document.getElementById('modal').addEventListener('click', e => { if (e.target.id === 'modal') closeModal(); });

