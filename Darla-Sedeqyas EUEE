function parseCSV(text) {
  const lines = text.replace(/\r/g,'').split('\n').filter(l => l.trim());
  if (!lines.length) return [];
  const headers = lines[0].split(',').map(h => h.trim());
  return lines.slice(1).map(line => {
    // naive CSV parser (handles quotes)
    const cells = [];
    let cur = '', inQ = false;
    for (let i=0;i<line.length;i++) {
      const ch = line[i];
      if (ch === '"') { inQ = !inQ; continue; }
      if (ch === ',' && !inQ) { cells.push(cur); cur=''; continue; }
      cur += ch;
    }
    cells.push(cur);
    const obj = {};
    headers.forEach((h,i) => obj[h] = (cells[i]||'').trim());
    return obj;
  });
}

function validateEuee(row) {
  const errors = [];
  if (!row.subject) errors.push('missing subject');
  if (!row.question) errors.push('missing question');
  if (!row.correct_answer) errors.push('missing correct_answer');
  if (row.correct_answer && !['A','B','C','D'].includes(String(row.correct_answer).toUpperCase())) errors.push('correct_answer must be A/B/C/D');
  if (!row.source) errors.push('missing source (mark as "Unverified" if unknown)');
  return errors;
}
function validateCurr(row) {
  const errors = [];
  if (!row.subject) errors.push('missing subject');
  if (!row.grade) errors.push('missing grade');
  return errors;
}

function importEuee() {
  const file = document.getElementById('fileEuee').files[0];
  if (!file) { alert('Select a file first.'); return; }
  const reader = new FileReader();
  reader.onload = e => {
    try {
      let rows;
      if (file.name.endsWith('.json')) rows = JSON.parse(e.target.result);
      else rows = parseCSV(e.target.result);
      if (!Array.isArray(rows)) throw new Error('Not an array');

      let added = 0, invalid = 0;
      const problems = [];
      rows.forEach((r,i) => {
        const errs = validateEuee(r);
        if (errs.length) { invalid++; problems.push(`Row ${i+1}: ${errs.join(', ')}`); return; }
        state.questions.push({
          year: r.year ? +r.year : null,
          ec_year: r.ec_year || '',
          stream: r.stream || '',
          subject: r.subject,
          grade: r.grade || '',
          unit: r.unit || '',
          topic: r.topic || '',
          question_number: r.question_number || '',
          question: r.question,
          choice_a: r.choice_a || '',
          choice_b: r.choice_b || '',
          choice_c: r.choice_c || '',
          choice_d: r.choice_d || '',
          correct_answer: String(r.correct_answer).toUpperCase(),
          explanation: r.explanation || '',
          difficulty: r.difficulty || 'Unverified',
          source: r.source,
          added: Date.now()
        });
        added++;
      });
      save('questions');
      alert(`Imported ${added} questions. ${invalid} invalid row(s).\n\n${problems.slice(0,10).join('\n')}`);
      render();
    } catch (err) { alert('Parse error: '+err.message); }
  };
  reader.readAsText(file);
}

