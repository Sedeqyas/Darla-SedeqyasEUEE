function drawAnalysisCharts() {
  const analysis = computeAnalysis();
  if (!analysis) return;
  const { rows } = analysis;
  const qs = state.questions;

  const groupCount = (arr, keyFn) => {
    const m = {};
    arr.forEach(x => { const k = keyFn(x) || 'Unverified'; m[k] = (m[k]||0)+1; });
    return m;
  };

  const palette = ['#0f7b3f','#1e4d8b','#c9a227','#b91c1c','#16a34a','#13315c','#e6c34a'];

  const makeChart = (id, labels, data, label) => {
    const ctx = document.getElementById(id);
    if (!ctx) return;
    new Chart(ctx, {
      type: 'bar',
      data: { labels, datasets: [{ label, data, backgroundColor: labels.map((_,i)=>palette[i%palette.length]) }] },
      options: { responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}} }
    });
  };

  const subjCounts = groupCount(qs, q => q.subject);
  makeChart('chartSubject', Object.keys(subjCounts), Object.values(subjCounts), 'Questions');

  const gradeCounts = groupCount(qs, q => q.grade ? 'Grade '+q.grade : null);
  makeChart('chartGrade', Object.keys(gradeCounts), Object.values(gradeCounts), 'Questions');

  const yearCounts = groupCount(qs, q => q.year);
  const sortedYears = Object.keys(yearCounts).sort();
  makeChart('chartYear', sortedYears, sortedYears.map(y=>yearCounts[y]), 'Questions');

  const diffCounts = groupCount(qs, q => q.difficulty);
  const dctx = document.getElementById('chartDiff');
  if (dctx) {
    new Chart(dctx, {
      type: 'doughnut',
      data: {
        labels: Object.keys(diffCounts),
        datasets: [{ data: Object.values(diffCounts), backgroundColor: ['#16a34a','#c9a227','#b91c1c','#64748b'] }]
      },
      options: { responsive:true, maintainAspectRatio:false }
    });
  }
}

