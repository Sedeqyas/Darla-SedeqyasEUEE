<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>🇪🇹 EUEE 24-Week Study Planner</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
:root {
  --deep-blue: #0b2545;
  --blue: #13315c;
  --blue-light: #1e4d8b;
  --green: #0f7b3f;
  --green-light: #16a34a;
  --gold: #c9a227;
  --gold-light: #e6c34a;
  --bg: #f4f6fa;
  --card: #ffffff;
  --border: #dde3ec;
  --text: #1a2332;
  --muted: #64748b;
  --red: #b91c1c;
  --yellow: #b45309;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
  font-size: 15px;
}
a { color: var(--blue-light); text-decoration: none; }
button { font-family: inherit; cursor: pointer; }

/* ---------- Layout ---------- */
.app { display: flex; min-height: 100vh; }
.sidebar {
  width: 250px;
  background: linear-gradient(180deg, var(--deep-blue) 0%, var(--blue) 100%);
  color: #fff;
  padding: 16px 0;
  position: fixed;
  top: 0; left: 0; bottom: 0;
  overflow-y: auto;
  z-index: 100;
  transition: transform .25s ease;
}
.sidebar-brand {
  padding: 0 18px 16px;
  border-bottom: 1px solid rgba(255,255,255,.12);
  margin-bottom: 12px;
}
.sidebar-brand h1 { font-size: 15px; line-height: 1.3; }
.sidebar-brand small { color: var(--gold-light); font-size: 11px; display: block; margin-top: 4px; }
.nav-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 18px;
  color: rgba(255,255,255,.82);
  font-size: 14px;
  border-left: 3px solid transparent;
  cursor: pointer;
}
.nav-item:hover { background: rgba(255,255,255,.08); color: #fff; }
.nav-item.active {
  background: rgba(255,255,255,.14);
  color: #fff;
  border-left-color: var(--gold);
  font-weight: 600;
}
.nav-item .ico { width: 18px; text-align: center; }

.main {
  flex: 1;
  margin-left: 250px;
  padding: 20px 26px 60px;
  max-width: 1400px;
}
.topbar {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 20px; gap: 12px; flex-wrap: wrap;
}
.topbar h2 { font-size: 22px; color: var(--deep-blue); }
.topbar .sub { color: var(--muted); font-size: 13px; margin-top: 3px; }

.hamburger {
  display: none;
  background: var(--deep-blue); color: #fff;
  border: none; padding: 8px 12px; border-radius: 6px;
  font-size: 18px;
}

/* ---------- Cards ---------- */
.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 16px 18px;
  margin-bottom: 16px;
  box-shadow: 0 1px 2px rgba(11,37,69,.04);
}
.card h3 { font-size: 15px; color: var(--deep-blue); margin-bottom: 10px; }
.card .hint { color: var(--muted); font-size: 12px; }

.grid { display: grid; gap: 14px; }
.grid-2 { grid-template-columns: repeat(2, 1fr); }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

.stat { text-align: left; }
.stat .label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
.stat .value { font-size: 26px; font-weight: 700; color: var(--deep-blue); margin-top: 4px; }
.stat .value.green { color: var(--green); }
.stat .value.gold { color: var(--gold); }
.stat .value.red { color: var(--red); }

.progress-bar {
  background: #e8edf5; border-radius: 20px; height: 12px;
  overflow: hidden; margin-top: 8px;
}
.progress-bar > div {
  height: 100%;
  background: linear-gradient(90deg, var(--green) 0%, var(--green-light) 100%);
  transition: width .3s ease;
}

.badge {
  display: inline-block; padding: 2px 9px; border-radius: 20px;
  font-size: 11px; font-weight: 600; letter-spacing: .02em;
}
.badge-high { background: #fee2e2; color: #991b1b; }
.badge-medium { background: #fef3c7; color: #92400e; }
.badge-foundation { background: #dcfce7; color: #166534; }
.badge-blue { background: #dbeafe; color: #1e40af; }
.badge-green { background: #dcfce7; color: #166534; }
.badge-gray { background: #f1f5f9; color: #475569; }
.badge-gold { background: #fef9c3; color: #854d0e; }

.btn {
  background: var(--blue-light); color: #fff; border: none;
  padding: 8px 14px; border-radius: 6px; font-size: 13px; font-weight: 500;
}
.btn:hover { background: var(--blue); }
.btn-green { background: var(--green); }
.btn-green:hover { background: #0a5f30; }
.btn-gold { background: var(--gold); color: #3a2f00; }
.btn-outline { background: transparent; border: 1px solid var(--border); color: var(--text); }
.btn-outline:hover { background: #eef2f9; }
.btn-sm { padding: 5px 10px; font-size: 12px; }
.btn-danger { background: var(--red); }

input, select, textarea {
  font-family: inherit; font-size: 13px;
  padding: 7px 10px; border: 1px solid var(--border);
  border-radius: 6px; width: 100%; background: #fff; color: var(--text);
}
input:focus, select:focus, textarea:focus {
  outline: 2px solid var(--blue-light); outline-offset: -1px;
}

table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td { text-align: left; padding: 9px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
th { background: #f7f9fc; font-weight: 600; color: var(--deep-blue); font-size: 12px; text-transform: uppercase; letter-spacing: .03em; }
tr:hover td { background: #fafbfd; }

.topic-cell { cursor: pointer; }
.topic-cell:hover { color: var(--blue-light); text-decoration: underline; }

.week-section { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: #fff; }
.week-header {
  background: linear-gradient(90deg, var(--deep-blue), var(--blue-light));
  color: #fff; padding: 11px 16px; font-weight: 600; font-size: 14px;
  display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;
}
.week-header .grade-tag {
  background: var(--gold); color: #3a2f00; padding: 2px 8px;
  border-radius: 4px; font-size: 11px; font-weight: 700;
}
.week-body { padding: 12px 16px; }
.week-body table td:first-child { font-weight: 600; width: 130px; color: var(--blue); }

.chk {
  appearance: none; width: 18px; height: 18px; border: 2px solid var(--blue-light);
  border-radius: 4px; cursor: pointer; position: relative; vertical-align: middle;
  background: #fff; flex-shrink: 0;
}
.chk:checked { background: var(--green); border-color: var(--green); }
.chk:checked::after {
  content: '✓'; color: #fff; position: absolute; top: -3px; left: 1px;
  font-size: 15px; font-weight: bold;
}

.modal-overlay {
  position: fixed; inset: 0; background: rgba(11,37,69,.55);
  display: none; align-items: center; justify-content: center; z-index: 200;
  padding: 16px;
}
.modal-overlay.open { display: flex; }
.modal {
  background: #fff; border-radius: 12px; max-width: 620px;
  width: 100%; max-height: 88vh; overflow-y: auto; padding: 22px;
  box-shadow: 0 20px 50px rgba(0,0,0,.3);
}
.modal h3 { color: var(--deep-blue); font-size: 18px; margin-bottom: 4px; }
.modal .modal-meta { color: var(--muted); font-size: 13px; margin-bottom: 14px; }
.modal .modal-close {
  float: right; background: none; border: none; font-size: 22px;
  color: var(--muted); cursor: pointer; line-height: 1;
}
.field { margin-bottom: 12px; }
.field label { display: block; font-size: 12px; font-weight: 600; color: var(--deep-blue); margin-bottom: 4px; }
.field .help { font-size: 11px; color: var(--muted); margin-top: 3px; }

.search-bar {
  display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px;
}
.search-bar input { flex: 1; min-width: 200px; }
.search-bar select { width: auto; min-width: 120px; }

.day-card {
  border: 1px solid var(--border); border-radius: 8px; padding: 12px;
  background: #fff; margin-bottom: 10px;
}
.day-card h4 { color: var(--deep-blue); font-size: 14px; margin-bottom: 6px; }
.day-card ul { list-style: none; font-size: 13px; }
.day-card li { padding: 3px 0; color: #334155; }

.calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }
.cal-cell {
  border: 1px solid var(--border); border-radius: 6px; padding: 8px 6px;
  min-height: 70px; background: #fff; cursor: pointer; font-size: 12px;
  position: relative; transition: .15s;
}
.cal-cell:hover { border-color: var(--blue-light); background: #f0f6ff; }
.cal-cell.today { border: 2px solid var(--gold); background: #fffbeb; }
.cal-cell .day-num { font-weight: 700; color: var(--deep-blue); font-size: 13px; }
.cal-cell .cal-tag {
  font-size: 9px; padding: 1px 4px; border-radius: 3px; margin-top: 3px;
  display: inline-block; background: #dbeafe; color: #1e40af;
}
.cal-cell .cal-tag.practice { background: #fee2e2; color: #991b1b; }
.cal-cell .cal-tag.revision { background: #fef9c3; color: #854d0e; }
.cal-cell .cal-tag.done { background: #dcfce7; color: #166534; }

.streak-flame { font-size: 20px; }
.notice {
  background: #fffbeb; border-left: 4px solid var(--gold);
  padding: 10px 14px; border-radius: 6px; font-size: 12.5px;
  color: #713f12; margin-bottom: 14px;
}
.notice-info { background: #eff6ff; border-left-color: var(--blue-light); color: #1e3a8a; }
.notice-danger { background: #fef2f2; border-left-color: var(--red); color: #7f1d1d; }

.hidden { display: none !important; }
.flex { display: flex; align-items: center; gap: 8px; }
.flex-between { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.mt-2 { margin-top: 8px; } .mt-3 { margin-top: 14px; }
.muted { color: var(--muted); font-size: 12px; }

.chart-wrap { position: relative; height: 260px; }

/* Mobile */
@media (max-width: 900px) {
  .grid-4 { grid-template-columns: repeat(2, 1fr); }
  .grid-3 { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 640px) {
  .sidebar { transform: translateX(-100%); }
  .sidebar.open { transform: translateX(0); }
  .main { margin-left: 0; padding: 14px; }
  .hamburger { display: block; }
  .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
  .topbar h2 { font-size: 18px; }
  .stat .value { font-size: 22px; }
  table { font-size: 12px; }
  th, td { padding: 7px 6px; }
  .calendar-grid { grid-template-columns: repeat(4, 1fr); }
}
</style>
</head>
<body>
<div class="app">
  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <h1>🇪🇹 EUEE 24-Week Study Planner</h1>
      <small>Grades 9–12 • Curriculum + Past-Paper Prep</small>
    </div>
    <nav id="nav">
      <div class="nav-item active" data-page="dashboard"><span class="ico">📊</span> Dashboard</div>
      <div class="nav-item" data-page="plan"><span class="ico">📅</span> 24-Week Plan</div>
      <div class="nav-item" data-page="curriculum"><span class="ico">📚</span> Curriculum</div>
      <div class="nav-item" data-page="euee"><span class="ico">📝</span> EUEE Questions</div>
      <div class="nav-item" data-page="practice"><span class="ico">⏱️</span> Practice Exam</div>
      <div class="nav-item" data-page="analysis"><span class="ico">📈</span> Topic Analysis</div>
      <div class="nav-item" data-page="errors"><span class="ico">🩹</span> Error Log</div>
      <div class="nav-item" data-page="english"><span class="ico">🔤</span> English</div>
      <div class="nav-item" data-page="aptitude"><span class="ico">🧠</span> Aptitude</div>
      <div class="nav-item" data-page="progress"><span class="ico">🎯</span> Progress</div>
      <div class="nav-item" data-page="import"><span class="ico">📥</span> Data Import</div>
      <div class="nav-item" data-page="settings"><span class="ico">⚙️</span> Settings</div>
    </nav>
  </aside>

  <main class="main">
    <div class="topbar">
      <div class="flex">
        <button class="hamburger" onclick="toggleSidebar()">☰</button>
        <div>
          <h2 id="pageTitle">Dashboard</h2>
          <div class="sub" id="pageSub">Your EUEE preparation at a glance</div>
        </div>
      </div>
      <div class="flex">
        <input type="search" id="globalSearch" placeholder="🔍 Search topics, questions, subjects…" style="min-width:240px;" />
      </div>
    </div>

    <div id="pageContent"></div>
  </main>
</div>

<div class="modal-overlay" id="modal">
  <div class="modal" id="modalContent"></div>
</div>

<script>
/* =========================================================
   DATA LAYER
   ========================================================= */
const STORAGE_KEYS = {
  progress: 'euee_progress_v1',
  errors: 'euee_errors_v1',
  practice: 'euee_practice_v1',
  notes: 'euee_notes_v1',
  streak: 'euee_streak_v1',
  curriculum: 'euee_curriculum_v1',
  questions: 'euee_questions_v1',
  english: 'euee_english_v1',
  aptitude: 'euee_aptitude_v1',
  settings: 'euee_settings_v1'
};

const store = {
  get(key, fallback) {
    try { const v = localStorage.getItem(key); return v ? JSON.parse(v) : fallback; }
    catch { return fallback; }
  },
  set(key, val) { localStorage.setItem(key, JSON.stringify(val)); },
  remove(key) { localStorage.removeItem(key); }
};

/* =========================================================
   CURRICULUM PLAN (24 weeks) — fixed structure as specified
   ========================================================= */
const PLAN = [
  { wk:1, grade:"Grade 9", topic:{ Biology:"Cells & organization", Chemistry:"Matter & measurements", Physics:"Measurement & motion", Mathematics:"Number/algebra foundations" } },
  { wk:2, grade:"Grade 9", topic:{ Biology:"Biomolecules", Chemistry:"Atomic structure", Physics:"Motion", Mathematics:"Algebra" } },
  { wk:3, grade:"Grade 9", topic:{ Biology:"Cell division", Chemistry:"Periodic table", Physics:"Force", Mathematics:"Equations" } },
  { wk:4, grade:"Grade 9", topic:{ Biology:"Microorganisms", Chemistry:"Chemical bonding", Physics:"Work & energy", Mathematics:"Geometry" } },
  { wk:5, grade:"Grade 10", topic:{ Biology:"Genetics foundations", Chemistry:"Chemical reactions", Physics:"Momentum", Mathematics:"Functions" } },
  { wk:6, grade:"Grade 10", topic:{ Biology:"Plant biology", Chemistry:"Mole concept", Physics:"Heat", Mathematics:"Coordinate geometry" } },
  { wk:7, grade:"Grade 10", topic:{ Biology:"Human biology", Chemistry:"Stoichiometry", Physics:"Waves", Mathematics:"Trigonometry" } },
  { wk:8, grade:"Grade 10", topic:{ Biology:"Ecology", Chemistry:"Solutions", Physics:"Sound/light", Mathematics:"Statistics & probability" } },
  { wk:9, grade:"Grade 11", topic:{ Biology:"Genetics — HIGH PRIORITY", Chemistry:"Atomic structure", Physics:"Mechanics", Mathematics:"Functions" } },
  { wk:10, grade:"Grade 11", topic:{ Biology:"Genetics problems — HIGH PRIORITY", Chemistry:"Periodicity", Physics:"Kinematics", Mathematics:"Sequences" } },
  { wk:11, grade:"Grade 11", topic:{ Biology:"Human body systems", Chemistry:"Bonding", Physics:"Dynamics", Mathematics:"Limits" } },
  { wk:12, grade:"Grade 11", topic:{ Biology:"Human body systems", Chemistry:"Thermochemistry", Physics:"Energy", Mathematics:"Differentiation" } },
  { wk:13, grade:"Grade 11", topic:{ Biology:"Plant physiology", Chemistry:"Equilibrium", Physics:"Momentum", Mathematics:"Applications of derivatives" } },
  { wk:14, grade:"Grade 11", topic:{ Biology:"Ecology", Chemistry:"Acids & bases", Physics:"Circular motion", Mathematics:"Integration" } },
  { wk:15, grade:"Grade 12", topic:{ Biology:"Evolution", Chemistry:"Organic chemistry", Physics:"Electricity", Mathematics:"Integral applications" } },
  { wk:16, grade:"Grade 12", topic:{ Biology:"Human biology", Chemistry:"Organic reactions", Physics:"Electric circuits", Mathematics:"Probability" } },
  { wk:17, grade:"Grade 12", topic:{ Biology:"Climate/ecology", Chemistry:"Electrochemistry", Physics:"Magnetism", Mathematics:"Statistics" } },
  { wk:18, grade:"Grade 12", topic:{ Biology:"Full Biology revision", Chemistry:"Full Chemistry revision", Physics:"Waves/optics", Mathematics:"Calculus revision" } },
  { wk:19, grade:"Mixed revision", topic:{ Biology:"Grade 9–10 review", Chemistry:"Grade 9–10 review", Physics:"Grade 9–10 review", Mathematics:"Grade 9–10 review" } },
  { wk:20, grade:"Mixed revision", topic:{ Biology:"Grade 11 review", Chemistry:"Grade 11 review", Physics:"Grade 11 review", Mathematics:"Grade 11 review" } },
  { wk:21, grade:"Mixed revision", topic:{ Biology:"Grade 12 review", Chemistry:"Grade 12 review", Physics:"Grade 12 review", Mathematics:"Grade 12 review" } },
  { wk:22, grade:"EUEE practice", topic:{ Biology:"Past exams", Chemistry:"Past exams", Physics:"Past exams", Mathematics:"Past exams" } },
  { wk:23, grade:"EUEE practice", topic:{ Biology:"Timed papers", Chemistry:"Timed papers", Physics:"Timed papers", Mathematics:"Timed papers" } },
  { wk:24, grade:"Final review", topic:{ Biology:"Weak-topic repair", Chemistry:"Weak-topic repair", Physics:"Weak-topic repair", Mathematics:"Weak-topic repair" } }
];

/* Weekly routine (fixed) */
const WEEKLY_ROUTINE = [
  { day:"Monday",    items:[ {subject:"Mathematics",hours:1.5}, {subject:"Biology",hours:1.0} ] },
  { day:"Tuesday",   items:[ {subject:"Chemistry",hours:1.5}, {subject:"English",hours:1.0} ] },
  { day:"Wednesday", items:[ {subject:"Physics",hours:1.5}, {subject:"Mathematics",hours:1.0} ] },
  { day:"Thursday",  items:[ {subject:"Biology",hours:1.5}, {subject:"Chemistry",hours:1.0} ] },
  { day:"Friday",    items:[ {subject:"Physics",hours:1.5}, {subject:"Aptitude",hours:1.0} ] },
  { day:"Saturday",  items:[ {subject:"Mathematics",hours:2.0}, {subject:"Chemistry",hours:2.0}, {subject:"Biology",hours:2.0}, {subject:"Physics",hours:1.5} ] },
  { day:"Sunday",    items:[ {subject:"One timed EUEE paper",hours:2.0}, {subject:"Mark the paper",hours:0.5}, {subject:"Record mistakes",hours:0.5}, {subject:"Review weak topics",hours:1.0} ] }
];

/* Subjects */
const SUBJECTS = ["Biology","Chemistry","Physics","Mathematics","English","Aptitude"];

/* =========================================================
   STATE / UTILITIES
   ========================================================= */
let state = {
  page: 'dashboard',
  progress: store.get(STORAGE_KEYS.progress, {}),
  errors: store.get(STORAGE_KEYS.errors, []),
  practice: store.get(STORAGE_KEYS.practice, []),
  notes: store.get(STORAGE_KEYS.notes, {}),
  streak: store.get(STORAGE_KEYS.streak, { days: 0, lastDate: null, weekly: 0, weekStart: null }),
  curriculum: store.get(STORAGE_KEYS.curriculum, []),
  questions: store.get(STORAGE_KEYS.questions, []),
  english: store.get(STORAGE_KEYS.english, {}),
  aptitude: store.get(STORAGE_KEYS.aptitude, {}),
  settings: store.get(STORAGE_KEYS.settings, { studentName: "", startDate: new Date().toISOString().slice(0,10), currentWeek: 1 }),
  filters: { grade:"", subject:"", year:"", difficulty:"", priority:"", search:"" }
};

function save(key) {
  const keyMap = {
    progress: STORAGE_KEYS.progress,
    errors: STORAGE_KEYS.errors,
    practice: STORAGE_KEYS.practice,
    notes: STORAGE_KEYS.notes,
    streak: STORAGE_KEYS.streak,
    curriculum: STORAGE_KEYS.curriculum,
    questions: STORAGE_KEYS.questions,
    english: STORAGE_KEYS.english,
    aptitude: STORAGE_KEYS.aptitude,
    settings: STORAGE_KEYS.settings
  };
  store.set(keyMap[key], state[key]);
}

function esc(s) { return String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }

function taskId(wk, subject) { return `w${wk}_${subject}`; }

function isTaskDone(wk, subject) { return !!state.progress[taskId(wk, subject)]; }

function toggleTask(wk, subject) {
  const id = taskId(wk, subject);
  if (state.progress[id]) delete state.progress[id];
  else state.progress[id] = { done: true, ts: Date.now() };
  save('progress');
  updateStreak();
  render();
}

/* Total tasks = 24 weeks * 4 subjects */
function getTotalTasks() { return 24 * 4; }
function getCompletedTasks() {
  let n = 0;
  PLAN.forEach(w => ["Biology","Chemistry","Physics","Mathematics"].forEach(s => {
    if (state.progress[taskId(w.wk, s)]) n++;
  }));
  return n;
}

function getCurrentWeek() {
  // if start date known, compute; else use settings
  const start = state.settings.startDate ? new Date(state.settings.startDate) : null;
  if (!start) return state.settings.currentWeek || 1;
  const diff = Math.floor((Date.now() - start.getTime()) / (7*24*60*60*1000)) + 1;
  return Math.max(1, Math.min(24, diff));
}

function getCurrentPhase() {
  const wk = getCurrentWeek();
  if (wk <= 4) return "Grade 9 Foundation";
  if (wk <= 8) return "Grade 10 Core";
  if (wk <= 14) return "Grade 11 Advanced";
  if (wk <= 18) return "Grade 12 Specialization";
  if (wk <= 21) return "Mixed Revision";
  if (wk <= 23) return "EUEE Past-Paper Practice";
  return "Final Review";
}

/* =========================================================
   STREAK
   ========================================================= */
function updateStreak() {
  const today = new Date().toISOString().slice(0,10);
  const s = state.streak;
  if (s.lastDate !== today) {
    const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0,10);
    if (s.lastDate === yesterday) s.days = (s.days||0) + 1;
    else s.days = 1;
    s.lastDate = today;
  }
  // weekly
  const now = new Date();
  const weekStart = new Date(now.setDate(now.getDate() - now.getDay())).toISOString().slice(0,10);
  if (s.weekStart !== weekStart) { s.weekStart = weekStart; s.weekly = 1; }
  save('streak');
}

/* =========================================================
   NAVIGATION
   ========================================================= */
function toggleSidebar() { document.getElementById('sidebar').classList.toggle('open'); }
document.getElementById('nav').addEventListener('click', e => {
  const item = e.target.closest('.nav-item');
  if (!item) return;
  navigate(item.dataset.page);
  if (window.innerWidth <= 640) document.getElementById('sidebar').classList.remove('open');
});

function navigate(page) {
  state.page = page;
  document.querySelectorAll('.nav-item').forEach(n => n.classList.toggle('active', n.dataset.page === page));
  const titles = {
    dashboard:["Dashboard","Your EUEE preparation at a glance"],
    plan:["24-Week Study Plan","Grades 9 → 12 curriculum + revision + practice"],
